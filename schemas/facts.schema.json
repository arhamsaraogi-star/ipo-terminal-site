{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facts.schema.json",
  "title": "Company facts file \u2014 financials, industry and operating statistics",
  "type": "object",
  "required": [
    "company_id",
    "financials",
    "industry"
  ],
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "$ref": "common.schema.json#/$defs/company_id"
    },
    "financials": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/fact"
      }
    },
    "industry": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/fact"
      }
    },
    "operating": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/fact"
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Listed peers table from the offer document"
    },
    "industry_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "page"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        }
      },
      "description": "Verbatim quantitative statements from Industry Overview, with page"
    },
    "source_document": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}